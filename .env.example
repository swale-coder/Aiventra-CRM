# Supabase project — get these from https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key, used for privileged operations (e.g. inviting users). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Optional — powers the live AI Copilot, hot-lead scoring narration, and customer summary
# generation via OpenAI. Without this, the app falls back to the deterministic on-device
# scoring/summary engine in lib/ai/, so Phase 2 still works fully offline/without a key.
OPENAI_API_KEY=
